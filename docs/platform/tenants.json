  "_about": "Sample tenants for the Platform Explorer, one or more per segment. Reyes and Summit come from 02; Greenleaf is the sample dataset (21 §15.3, 22 §4.6); the rest are illustrative.",
  "module_catalog": [
    {
      "key": "core_maintenance",
      "name": "General maintenance (mowing, pruning, cleanups)",
      "depends_on": "none, always on",
      "plan_availability": "All plans (22)",
      "scope": "MVP",
      "scope_note": "MVP"
    },
    {
      "key": "lawn_phc",
      "name": "Lawn care and Plant Health Care programs",
      "depends_on": "Application Compliance Engine",
      "plan_availability": "All plans; Starter gets basic chemical logs only, without registry automation or regulator exports (22: \"L (lawn/PHC basic)\")",
      "scope": "MVP",
      "scope_note": "MVP"
    },
    {
      "key": "irrigation",
      "name": "Irrigation systems, seasonal services, repairs",
