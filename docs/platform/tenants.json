      "plan_availability": "Grow limited to 5 commercial clients (matches the commercial portal limit in 22); unlimited on Pro and Enterprise (proposed)",
      "scope": "MVP",
      "scope_note": "MVP"
    },
    {
      "key": "landscape_lighting",
      "name": "Lighting system inventory and service plans",
      "depends_on": "Property Asset Registry",
      "plan_availability": "All plans (22)",
      "scope": "V1",
      "scope_note": "V1"
    },
    {
      "key": "holiday_lighting",
      "name": "Holiday lighting install, takedown and storage",
