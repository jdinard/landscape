      "scope": "V1",
      "scope_note": "V1"
    },
    {
      "key": "smart_irrigation",
      "name": "Smart controller integrations, water budgets, leak alerts",
      "depends_on": "`irrigation`",
      "plan_availability": "Pro and Enterprise; Grow limited to 25 linked controllers (proposed)",
      "scope": "V1",
      "scope_note": "V1"
    },
    {
      "key": "snow_ice",
      "name": "Snow and ice management",
      "depends_on": "Snow Lite: Visit and photo pipeline only; full module: Storm Event Engine",
      "plan_availability": "Snow Lite (4.3.0) on all plans at no charge, and it stays included after the add-on launches (22); full module as add-on `snow_ice` on Starter, Grow and Pro, billed Nov-Mar only, included in Enterprise (22 section 4.5)",
      "scope": "MVP",
      "scope_note": "MVP (Snow Lite); V1 (full module)"
    },
    {
      "key": "tree_care",
      "name": "Tree inventory, ISA risk, prescriptions, permits, crane jobs",
      "depends_on": "Plant KB, Inspection Engine",
      "plan_availability": "Add-on `tree_care` on Starter and Grow; included in Pro and Enterprise (22)",
      "scope": "V2",
      "scope_note": "V2"
    },
    {
      "key": "install_projects",
      "name": "Installation and hardscape project management",
      "depends_on": "Project Engine, Warranty Engine",
      "plan_availability": "All plans (22); Gantt view Pro and Enterprise (proposed); 811 gating on every plan because it is a safety control",
      "scope": "MVP",
      "scope_note": "MVP"
    },
    {
      "key": "commercial_grounds",
      "name": "SOW specs, quality audits, enhancement pipeline, property reports",
